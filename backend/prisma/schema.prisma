generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role{
  ADMIN
  CUSTOMER
  DRIVER
  RESTAURANT_OWNER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  passwordHash String @map("password_hash")
  roles Role[]
  status UserStatus @default(ACTIVE)
  emailVerified Boolean @default(false) @map("email_verified")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  refreshSessions RefreshSession[]
  emailVerifications EmailVerification[]
  passwordResets PasswordReset[]
  customer Customer?
  restaurants Restaurant[]

  @@map("users")
}

model Customer {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  firstName String @map("first_name")
  lastName String @map("last_name")
  phone String
  preferences Json?
  avatarUrl String? @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@map("customers")
}

model RefreshSession{
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  familyId String @default(uuid()) @db.Uuid
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt DateTime? @map("revoked_at")
  replaceBySessionId String? @unique @map("replaced_by_session_id") @db.Uuid
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_sessions")
}

model EmailVerification{
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([verifiedAt])

  @@map("email_verifications")
}

model PasswordReset{
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])

  @@map("password_resets")
}

enum RestaurantStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
  CLOSED
}

model Restaurant{
  id String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  name String @map("restaurant_name")
  description String @map("restaurant_description")
  status RestaurantStatus @default(PENDING)
  phone String
  email String
  address Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cuisines RestaurantCuisines[]
  openingHours RestaurantOpeningHours[]

  @@index([ownerId])
  @@index([status])
  @@map("restaurants")
}

enum CuisineStatus {
  ACTIVE
  INACTIVE
}

model Cuisine {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  slug String @unique
  status CuisineStatus @default(ACTIVE) @map("cuisine_status")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

  restaurants RestaurantCuisines[]

  @@index([slug])
  @@map("cuisines")
}


model RestaurantCuisines{
  id String @id @default(uuid()) @db.Uuid
  restaurantId String @db.Uuid
  cuisineId String @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  cuisine Cuisine @relation(fields: [cuisineId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([restaurantId, cuisineId])
  @@index([restaurantId])
  @@index([cuisineId])
  @@map("restaurant_cuisines")
}

model RestaurantOpeningHours {
  id String @id @default(uuid()) @db.Uuid
  restaurantId String @db.Uuid
  dayOfWeek Int @map("day_of_week")
  opensAt String? @map("opens_at")
  closesAt String? @map("closes_at")
  isClosed Boolean @default(false) @map("is_closed")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([restaurantId, dayOfWeek])
  @@index([restaurantId])
  @@map("restaurant_opening_hours")
}
